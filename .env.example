# Local Supabase (values printed by `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
# Optional: point DB tests at an empty PostgreSQL 16+ instead of the throwaway cluster
# TEST_DATABASE_URL=postgres://postgres@localhost:54329/spa_test
# Live refresh polling interval in milliseconds (default 60000)
# NEXT_PUBLIC_LIVE_POLL_MS=60000
# Customer messages (Plan 2): shared secret for POST /api/internal/dispatch and the sender name shown in texts
CRON_SECRET=
NOTIFY_SENDER_NAME=Studio

# Optional: staff header brand (defaults shown)
# BRAND_NAME=BANYAN
# BRAND_TAGLINE=Men's Spa · Thailand

# development (default) or production. Production refuses to start with a missing or unsafe value (see docs/deployment.md)
APP_ENV=development
# Database used by the browser tests for direct SQL (default is the local Supabase database)
# E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Public booking page (LINE). Set all five or none; the page stays closed until they are set AND the owner turns on "online.enabled".
# LINE_LOGIN_CHANNEL_ID=
# LINE_LOGIN_CHANNEL_SECRET=
# LINE_MESSAGING_CHANNEL_SECRET= # Messaging API channel secret for the optional incoming webhook (different from LINE Login)
# LINE_MESSAGING_TOKEN=
# PUBLIC_BASE_URL=https://your-domain.example
# PUBLIC_TOKEN_SECRET=   # at least 32 random characters; signs guest sessions and cancel links
# Tests only: point LINE calls at a local stub
# LINE_API_BASE=
# LINE_AUTH_BASE=
