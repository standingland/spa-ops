    "metrics": {
      "booked": "Booked revenue: for bookings whose service starts in the period, the discounted price of completed bookings plus the fee on cancelled and no-show bookings. A rescheduled booking is one booking, counted on the day it finally starts.",
      "collected": "Collected revenue: payments received in the period, not counting voided ones. Money still awaiting verification is included here and shown separately under Payments.",
      "refunded": "Refunded: refunds recorded in the period, not counting voided ones.",
      "net": "Net collected: collected revenue minus refunds.",
      "avgTransaction": "Average transaction value: booked revenue of completed bookings divided by the number of completed bookings (fees excluded).",
      "cancellationRate": "Cancellation rate: cancelled bookings divided by all bookings starting in the period.",
      "noShowRate": "No-show rate: no-show bookings divided by all bookings starting in the period.",
      "reschedules": "Bookings: all bookings starting in the period, whatever their status. Reschedules are counted from the booking history, and a moved booking is still one booking.",
      "returningRate": "Returning customer rate: of customers with a completed booking in the period, the share who had a completed booking before their first one in the period.",
      "roomUtilization": "Room utilisation: booked room minutes divided by open minutes, less maintenance or closed blocks on that room. Open minutes are the minutes covered by at least one rostered therapist shift. Turnover: the average minutes from start to ready and the share marked ready on time.",
      "therapistUtilization": "Therapist utilisation: booked minutes divided by shift minutes, less time off inside shifts.",
      "turnover": "Turnover efficiency: for turnovers started in the period, the average minutes from start to ready and the share marked ready by the due time.",
      "peaks": "Peak periods: bookings that are not cancelled or no-show, by weekday and by hour of the start time (Bangkok time).",
      "byService": "Revenue by service: completed bookings only, discounted price, fees not attributed. Retired services still appear when they have completed bookings in the period.",
      "byTherapist": "Revenue by therapist: completed bookings only, discounted price, fees not attributed. Therapists who left still appear when they have completed bookings in the period.",
